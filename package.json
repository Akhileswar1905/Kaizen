  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "transpile:electron": "tsc -p src/electron/tsconfig.json",
    "dist:mac": "npm run transpile:electron && npm run build &&electron-builder --mac --arm64",
